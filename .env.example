# Mapbox access token for the Traverse distance tool (/traverse).
# Get one free at https://account.mapbox.com/access-tokens/
# Copy this file to `.env.local` and fill in your token, then restart `npm run dev`.
#
# Without a token, the Traverse tool still works in "Direct" (straight-line)
# mode — the schematic panel and distance matrix render — but the Mapbox map,
# place search, and routed modes (driving / walking / cycling) are disabled.
VITE_MAPBOX_TOKEN=
