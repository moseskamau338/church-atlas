{
  "name": "gathera-church-vue",
  "version": "0.1.3",
  "description": "Editorial-style church atlas for the Gathera SDA District — Vue 3 port of the original Claude Design prototype.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://moseskamau338.github.io/church-atlas/",
  "repository": {
    "type": "git",
    "url": "https://github.com/moseskamau338/church-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/moseskamau338/church-atlas/issues"
  },
  "keywords": [
    "vue",
    "leaflet",
    "sda",
    "church-atlas",
    "data-visualization",
    "kenya"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,vue,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,vue,json,md,css,html}\""
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "mapbox-gl": "^3.25.0",
    "open-location-code": "^1.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
